# gasworks-companion — standalone Gas City Companion endpoint (systemd USER service).
#
# GOVERNING INVARIANT: ZERO Gas City dependency. This is a per-user service — installed under
# ~/.config/systemd/user and run with `systemctl --user`, NEVER system-wide, NEVER with sudo.
# It has no gc, City, or tmux dependency.
#
# Enable (no sudo):
#   systemctl --user daemon-reload
#   systemctl --user enable --now gasworks-companion.service
#
# LINGERING: a user service only runs while the user has a login session unless linger is on.
# To keep the endpoint collecting across logout/reboot (no sudo required for your own user):
#   loginctl enable-linger "$USER"
#
# The daemon argv + state dir come from the owner-only EnvironmentFile that install.sh writes.
# On restart the daemon recovers its WAL from the state dir, so a restart never loses spool.

[Unit]
Description=Gas City Companion endpoint (standalone user service)
Documentation=https://github.com/gascity/gasworks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Owner-only config (0600) written by install.sh: GASWORKS_OBSERVER_DIR + OBSERVER_ARGS.
EnvironmentFile=%h/.config/gasworks-companion/observer.env

# $OBSERVER_ARGS is intentionally unbraced so systemd word-splits it into the daemon argv
# (e.g. "daemon -dir … -source-id … -collector …").
ExecStart=%h/.local/bin/gasworks-companion $OBSERVER_ARGS

# Graceful drain: SIGTERM lets the daemon flush and close the spool; the WAL is recovered on
# the next start, so stop/restart never loses acknowledged evidence.
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=on-failure
RestartSec=5

# Hardening — the endpoint runs unattended holding an ingest credential. Confine it to its own
# owner-only paths. ReadWritePaths re-opens the state dir (WAL/socket) under ProtectHome.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/gasworks-companion
PrivateTmp=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
